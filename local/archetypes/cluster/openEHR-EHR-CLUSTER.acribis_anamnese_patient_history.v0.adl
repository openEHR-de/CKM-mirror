definition
	CLUSTER[at0000] matches {    -- ACRIBIS Anamnese Patient history
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Does the patient have a heart valve disease?
				value matches {
					1|[local::at0003],
					2|[local::at0004],
					3|[local::at0005]
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Which valve is affected?
				value matches {
					1|[local::at0006],
					2|[local::at0007],
					3|[local::at0008],
					4|[local::at0009],
					5|[local::at0010]
				}
			}
			ELEMENT[at0011] occurrences matches {0..1} matches {    -- Is the heart valve disease a stenotic disease or an insufficiency?
				value matches {
					1|[local::at0012],
					2|[local::at0013],
					3|[local::at0014],
					4|[local::at0015]
				}
			}
			ELEMENT[at0016] occurrences matches {0..1} matches {    -- How was the disease treated?
				value matches {
					1|[local::at0017],
					2|[local::at0018],
					3|[local::at0019],
					4|[local::at0020],
					5|[local::at0021]
				}
			}
			ELEMENT[at0022] occurrences matches {0..1} matches {    -- Is a congenital heart defect known in the patient (except: bicuspid aortic valve and PFO)?
				value matches {
					1|[local::at0023],
					2|[local::at0024],
					3|[local::at0025]
				}
			}
			ELEMENT[at0026] occurrences matches {0..1} matches {    -- Was a defibrillator or pacemaker implanted in the patient?
				value matches {
					1|[local::at0027],
					2|[local::at0028],
					3|[local::at0029]
				}
			}
			allow_archetype CLUSTER[at0086] occurrences matches {0..*} matches {    -- Implanted device
				include
					archetype_id/value matches {/.*/}
			}
			ELEMENT[at0037] occurrences matches {0..1} matches {    -- Does the patient has narrowing/disease of the coronary vessels (CAD)?
				value matches {
					1|[local::at0038],
					2|[local::at0039],
					3|[local::at0040]
				}
			}
			CLUSTER[at0048] occurrences matches {0..1} matches {    -- Carotid arteries
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0041] occurrences matches {0..1} matches {    -- Are narrowings or plaque deposits (cAVD) of the carotid arteries known in the patient?
						value matches {
							1|[local::at0042],
							2|[local::at0043],
							3|[local::at0044]
						}
					}
					ELEMENT[at0047] occurrences matches {0..1} matches {    -- When was this first diagnosed?
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0049] occurrences matches {0..1} matches {    -- Was there ever a surgery or catheter intervention on the carotid arteries because of this?
						value matches {
							1|[local::at0050],
							2|[local::at0051],
							3|[local::at0052],
							4|[local::at0053]
						}
					}
					ELEMENT[at0054] occurrences matches {0..1} matches {    -- Has the patient ever had an embolic vascular occlusion in the head/neck region (e.g. TIA/stroke/amaurosis fugax/retinal infarction)?
						value matches {
							1|[local::at0055],
							2|[local::at0056],
							3|[local::at0057]
						}
					}
					ELEMENT[at0058] occurrences matches {0..1} matches {    -- What type of vascular occlusion in the head/neck region was it?
						value matches {
							1|[local::at0059],
							2|[local::at0060],
							3|[local::at0061],
							4|[local::at0062],
							5|[local::at0063]
						}
					}
				}
			}
			ELEMENT[at0064] occurrences matches {0..1} matches {    -- Has the patient ever had an arterial vascular occlusion due to a blood clot outside the head/neck region?
				value matches {
					1|[local::at0065],
					2|[local::at0066],
					3|[local::at0067]
				}
			}
			ELEMENT[at0068] occurrences matches {0..1} matches {    -- Are calcifications of the aorta known in the patient?
				value matches {
					1|[local::at0069],
					2|[local::at0070],
					3|[local::at0071]
				}
			}
			ELEMENT[at0072] occurrences matches {0..1} matches {    -- Is atrial fibrillation known in the patient?
				value matches {
					1|[local::at0073],
					2|[local::at0074],
					3|[local::at0075]
				}
			}
			ELEMENT[at0076] occurrences matches {0..1} matches {    -- When was atrial fibrillation first diagnosed?
				value matches {
					DV_DATE_TIME matches {*}
				}
			}
			ELEMENT[at0077] occurrences matches {0..1} matches {    -- Does the patient have arterial hypertension (high blood pressure) or take medication for it?
				value matches {
					1|[local::at0078],
					2|[local::at0079],
					3|[local::at0080]
				}
			}
			ELEMENT[at0081] occurrences matches {0..1} matches {    -- Is or was an abdominal aortic aneurysm (pathological widening of the aorta) known in the patient?
				value matches {
					1|[local::at0082],
					2|[local::at0083],
					3|[local::at0084]
				}
			}
		}
	}

